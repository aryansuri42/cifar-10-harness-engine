import tensorflow as tf
from tensorflow.keras import layers, models, datasets
import numpy as np

# Load data
d = np.load("data/cifar10_split.npz")
x_train, y_train = d["x_train"], d["y_train"]
x_val, y_val = d["x_val"], d["y_val"]
x_test, y_test = d["x_test"], d["y_test"]

# Define the model
def residual_block(x, filters, stride=1):
    shortcut = x
    x = layers.Conv2D(filters, (3, 3), strides=stride, use_bias=False, padding='same')(x)
    x = layers.BatchNormalization()(x, training=True)
    x = layers.ReLU()(x)
    x = layers.Conv2D(filters, (3, 3), use_bias=False, padding='same')(x)
    x = layers.BatchNormalization()(x, training=True)
    if stride != 1 or filters != layers.Conv2D.filters.shortcut:
        shortcut = layers.Conv2D(filters, (1, 1), strides=stride, use_bias=False, padding='same')(shortcut)
        shortcut = layers.BatchNormalization()(shortcut, training=True)
    x = layers.Add()([shortcut, x])
    x = layers.ReLU()(x)
    return x

model = models.Sequential([
    layers.Input(shape=(32, 32, 3)),
    layers.Rescaling(1./255),
    layers.RandomFlip("horizontal"),
    layers.Conv2D(64, (3, 3), activation='relu', padding='same'),
    layers.MaxPooling2D((2, 2)),
    residual_block(layers.Conv2D(64, (3, 3), activation='relu', padding='same'), 64, stride=1),
    residual_block(layers.Conv2D(64, (3, 3), activation='relu', padding='same'), 64, stride=1),
    layers.Conv2D(128, (3, 3), activation='relu', padding='same'),
    layers.MaxPooling2D((2, 2)),
    residual_block(layers.Conv2D(128, (3, 3), activation='relu', padding='same'), 128, stride=2),
    residual_block(layers.Conv2D(128, (3, 3), activation='relu', padding='same'), 128, stride=1),
    layers.Conv2D(256, (3, 3), activation='relu', padding='same'),
    layers.MaxPooling2D((2, 2)),
    residual_block(layers.Conv2D(256, (3, 3), activation='relu', padding='same'), 256, stride=2),
    residual_block(layers.Conv2D(256, (3, 3), activation='relu', padding='same'), 256, stride=1),
    layers.GlobalAveragePooling2D(),
    layers.Dropout(0.5),
    layers.Dense(10, activation='softmax', dtype="float32")
])

# Compile the model
model.compile(optimizer='adam', loss='sparse_categorical_crossentropy', metrics=['accuracy'])

# Define callbacks
checkpoint = tf.keras.callbacks.ModelCheckpoint("models/cifar10_cnn.keras", monitor="val_accuracy", save_best_only=True)
early_stopping = tf.keras.callbacks.EarlyStopping(monitor="val_accuracy", patience=10, restore_best_weights=True)

# Train the model
history = model.fit(x_train, y_train, epochs=150, validation_data=(x_val, y_val), callbacks=[checkpoint, early_stopping], verbose=2)

# Evaluate the model
test_loss, test_acc = model.evaluate(x_test, y_test)
print(f"FINAL_TEST_ACCURACY={test_acc:.4f}")
```
