```python
import tensorflow as tf
from tensorflow.keras import layers, models
import numpy as np

# Load data
d = np.load("data/cifar10_split.npz")
x_train, y_train = d["x_train"], d["y_train"]
x_val, y_val = d["x_val"], d["y_val"]
x_test, y_test = d["x_test"], d["y_test"]

# Define the model
def residual_block(x, filters, stride=1):
    shortcut = x
    x = layers.Conv2D(filters, (3, 3), Activation='relu', padding='same', strides=stride)(x)
    x = layers.BatchNormalization()(x)
    x = layers.Conv2D(filters, (3, 3), Activation=None, padding='same')(x)
    x = layers.BatchNormalization()(x)
    
    shortcut = layers.Conv2D(filters, (3, 3), Activation=None, padding='same', strides=stride)(shortcut)
    shortcut = layers.BatchNormalization()(shortcut)

    x = layers.Add()([x, shortcut])
    x = layers.Activation('relu')(x)

    return x

model = models.Sequential([
    layers.Rescaling(1./255),
    layers.Conv2D(64, (3, 3), activation='relu', padding='same', strides=2),
    layers.BatchNormalization(),
    residual_block(layers.BatchNormalization()(layers.Conv2D(64, (1, 1), activation=None, padding='same')(layers.BatchNormalization()(layers.Conv2D(64, (3, 3), activation=None, padding='same', strides=2)(x_train)))), 64),
    residual_block(layers.BatchNormalization()(layers.Conv2D(64, (1, 1), activation=None, padding='same')(x_train)), 64),
    residual_block(layers.BatchNormalization()(layers.Conv2D(128, (1, 1), activation=None, padding='same')(x_train)), 128, stride=2),
    residual_block(layers.BatchNormalization()(layers.Conv2D(128, (1, 1), activation=None, padding='same')(x_train)), 128),
    layers.Conv2D(256, (3, 3), activation='relu', padding='same', strides=2),
    layers.BatchNormalization(),
    residual_block(layers.BatchNormalization()(layers.Conv2D(256, (1, 1), activation=None, padding='same')(x_train)), 256)
])

# Define the final layer
model.add(layers.Conv2D(256, kernel_size=(3,3), padding='same', activation='relu'))
model.add(layers.BatchNormalization())
model.add(layers.MaxPooling2D(pool_size=(8,8), strides=(8,8)))

# Compile the model
model.compile(optimizer='adam', loss='sparse_categorical_crossentropy', metrics=['accuracy'])

# Define callbacks
checkpoint = tf.keras.callbacks.ModelCheckpoint("models/cifar10_cnn.keras", monitor="val_accuracy", save_best_only=True)
early_stopping = tf.keras.callbacks.EarlyStopping(monitor="val_accuracy", patience=10, restore_best_weights=True)

# Train the model
history = model.fit(x_train, y_train, epochs=100, validation_data=(x_val, y_val), callbacks=[checkpoint, early_stopping], verbose=2)

# Evaluate the model
test_loss, test_acc = model.evaluate(x_test, y_test)
print(f"FINAL_TEST_ACCURACY={test_acc:.4f}")
