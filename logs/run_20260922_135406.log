```python
import tensorflow as tf
from tensorflow.keras import layers, models
import numpy as np
from tensorflow.keras.layers import Conv2D, BatchNormalization, Add, ReLU, GlobalAveragePooling2D, Dense

def residual_block(x, filters, stride=1):
    shortcut = x

    x = Conv2D(filters, (3, 3), strides=stride, use_bias=False, padding='same')(x)
    x = BatchNormalization()(x)
    x = ReLU()(x)

    x = Conv2D(filters, (3, 3), use_bias=False, padding='same')(x)
    x = BatchNormalization()(x)

    if stride != 1 or x.shape[3] != shortcut.shape[3]:
        shortcut = Conv2D(filters, (1, 1), strides=stride, use_bias=False, padding='same')(shortcut)
        shortcut = BatchNormalization()(shortcut)

    x = Add()([x, shortcut])
    x = ReLU()(x)

    return x

# Load data
d = np.load("data/cifar10_split.npz")
x_train, y_train = d["x_train"], d["y_train"]
x_val, y_val = d["x_val"], d["y_val"]
x_test, y_test = d["x_test"], d["y_test"]

# Define the model
model = models.Sequential([
    layers.Rescaling(1./255),
    layers.Conv2D(64, (3, 3), activation='relu', padding='same'),
    layers.BatchNormalization(),
    layers.MaxPooling2D((2, 2)),
    residual_block(layers.Conv2D(128, (3, 3), activation='relu', padding='same'), 128, stride=2),
    *([residual_block(layers.Conv2D(128, (3, 3), activation='relu', padding='same'), 128) for _ in range(2)]),
    residual_block(layers.Conv2D(256, (3, 3), activation='relu', padding='same'), 256, stride=2),
    *([residual_block(layers.Conv2D(256, (3, 3), activation='relu', padding='same'), 256) for _ in range(2)]),
    residual_block(layers.Conv2D(512, (3, 3), activation='relu', padding='same'), 512, stride=2),
    *([residual_block(layers.Conv2D(512, (3, 3), activation='relu', padding='same'), 512) for _ in range(2)]),
    GlobalAveragePooling2D(),
    layers.Dense(10, activation='softmax')
])

# Compile the model
model.compile(optimizer='adam', loss='sparse_categorical_crossentropy', metrics=['accuracy'])

# Define callbacks
checkpoint = tf.keras.callbacks.ModelCheckpoint("models/cifar10_cnn.keras", monitor="val_accuracy", save_best_only=True)
early_stopping = tf.keras.callbacks.EarlyStopping(monitor="val_accuracy", patience=20, restore_best_weights=True)
time_callback = tf.keras.callbacks.LambdaCallback(on_epoch_end=lambda epoch, logs: print(f"FINAL_TEST_ACCURACY={logs['val_accuracy']:.4f}"))

# Train the model
history = model.fit(x_train, y_train, epochs=200, validation_data=(x_val, y_val), callbacks=[checkpoint, early_stopping, time_callback], verbose=2)
